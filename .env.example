# Copy to .env for local development. In production these are set by the host.

# --- Database (required) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=railway
# "disable" for a private network (Railway internal), "require" over the internet.
DB_SSLMODE=disable

# --- Auth (required) ---
# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=
# Username of the account that gets admin tokens on login.
ADMIN_USER=admin

# --- Epic Games app credentials (required for token refresh / gifting) ---
EPIC_CLIENT=
EPIC_SECRET=

# --- Behaviour (optional) ---
# Seconds between background friend-request acceptance sweeps.
ACCEPT_FRIENDS_IN_SECONDS=5
# Whether to fetch pavos from Epic (false = manual price subtraction only).
FETCH_PAVOS=true
# Comma-separated CORS origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://kidstoreperu-frontend-react-production.up.railway.app
# HTTP port (most PaaS inject this automatically).
PORT=8080
