# Normalize line endings: LF in the repo, checked out as-is per platform.
* text=auto eol=lf

*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.json   text eol=lf
*.sh     text eol=lf

*.woff2  binary
*.png    binary
*.jpg    binary
*.ico    binary
